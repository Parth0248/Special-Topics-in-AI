# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Project 1: harness-from-scratch ---
# Google AI Studio key (https://aistudio.google.com/apikey). Free tier is enough.
GOOGLE_API_KEY=

# Model used by the agent loop. Any Gemini model id works.
HARNESS_MODEL=gemini-2.5-flash

# --- Optional alternate provider ---
# If set, the harness talks to OpenRouter instead of Google directly.
OPENROUTER_API_KEY=
