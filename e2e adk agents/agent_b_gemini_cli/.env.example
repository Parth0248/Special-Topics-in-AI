# ==============================================================================
# Agent B: Gemini CLI in ADK Pipeline Tool Agent Environment Configuration
# ==============================================================================

# Google Gemini API key used for SDK fallback when Gemini CLI binary is absent
GOOGLE_API_KEY=your_gemini_api_key_here

# Target Gemini model for SDK fallback and ADK agent execution
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-3.8-flash
HARNESS_MODEL=gemini-2.5-flash

# Force fallback mode to bypass the external `gemini` CLI binary:
# Set to 1 or true to always route through google.genai SDK / offline emulator
GEMINI_CLI_FALLBACK=0

# Optional explicit path or name for the Gemini CLI binary executable
GEMINI_CLI_PATH=gemini

# Default subprocess timeout in seconds
GEMINI_CLI_TIMEOUT=120
