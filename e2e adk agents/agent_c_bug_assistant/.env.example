# Agent C: MCP Tools-Based Bug Assistant Configuration

# Gemini API Key (Optional for deterministic offline triage, required for online Gemini LLM reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Default Gemini Model
DEFAULT_MODEL=gemini-2.5-flash

# Execution Mode: embedded (direct in-process) or mcp (FastMCP stdio server)
AGENT_C_MODE=embedded

# Target Workspace Root (Defaults to current directory)
WORKSPACE_ROOT=.
