# ==============================================================================
# Agent D: Production-Quality Code Review Assistant Environment Configuration
# ==============================================================================

# Google Gemini API Key (optional for deterministic review, used for AI insights)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Default Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Review Settings
MAX_COMPLEXITY_THRESHOLD=10
PEP8_PASSING_SCORE=80.0
AUTO_FIX_MAX_ITERATIONS=3
