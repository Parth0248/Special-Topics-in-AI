# ==============================================================================
# Agent A: Deep Research Lead Generation Agent — Configuration Template
# ==============================================================================

# Google Gemini API Key for live search grounding and synthesis
# Acquire from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Default Gemini model used for live reasoning and search grounding
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash
HARNESS_MODEL=gemini-2.5-flash

# Force offline mock execution (bypasses network/API calls)
# Set to '1' or 'true' to execute deterministically against curated mock dataset
MOCK_MODE=0

# Default minimum qualification fit score threshold (0.0 to 100.0)
DEFAULT_MIN_FIT_SCORE=60.0
