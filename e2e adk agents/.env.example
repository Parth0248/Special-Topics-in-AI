# ==============================================================================
# Google Agent Development Kit (ADK) Enterprise Multi-Agent Suite (.env.example)
# ==============================================================================
# This file defines all environment variables used across the 5 ADK agents,
# tool providers, vector stores, and automated test fixtures.
#
# QUICKSTART:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Populate GOOGLE_API_KEY with your Google Gemini API key.
#   3. (Optional) Configure AlloyDB credentials or use default local SQLite fallback.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE GEMINI & ADK FOUNDATION
# ------------------------------------------------------------------------------
# Required for live cloud generation across Agents A, B, C, D, and E.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Default Gemini model used for agent reasoning loops and tool calling
GEMINI_MODEL=gemini-2.5-flash

# Secondary / fallback model identifier used in test harnesses
HARNESS_MODEL=gemini-2.5-flash

# Text embedding model used for 768-dimensional vector embeddings (Agent E)
EMBEDDING_MODEL=text-embedding-004

# Execution and integrity mode: 'demo' (deterministic offline) or 'production' (live cloud APIs)
AGENT_INTEGRITY_MODE=demo

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 2. AGENT A: DEEP RESEARCH & LEAD GENERATION
# ------------------------------------------------------------------------------
# Minimum qualified lead fit score threshold (0.0 to 100.0)
AGENT_A_MIN_FIT_SCORE=65.0

# Maximum candidate companies evaluated per research cycle
AGENT_A_CANDIDATE_LIMIT=8

# Force deterministic offline candidate dataset without incurring search API costs
FALLBACK_TO_MOCK_SEARCH=true

# (Optional) Live Google Search Grounding API credentials (if enabled)
SERPER_API_KEY=


# ------------------------------------------------------------------------------
# 3. AGENT B: GEMINI CLI IN ADK PIPELINE TOOL AGENT
# ------------------------------------------------------------------------------
# Path to Gemini CLI binary. Default: 'gemini' (resolved from system PATH)
# On Windows, can be 'C:\\Users\\<username>\\AppData\\Roaming\\npm\\gemini.cmd'
GEMINI_CLI_PATH=gemini

# Execution timeout for headless CLI tool subprocess invocations (seconds)
GEMINI_CLI_TIMEOUT_SECONDS=60

# When true, falls back to Google GenAI SDK or mock emulator if CLI binary is absent
FALLBACK_TO_MOCK_CLI=true


# ------------------------------------------------------------------------------
# 4. AGENT C: MCP TOOLS-BASED BUG ASSISTANT
# ------------------------------------------------------------------------------
# Tool execution mode: 'embedded' (in-process direct calls) or 'mcp' (FastMCP stdio server)
AGENT_C_TOOL_MODE=embedded

# Maximum context lines inspected above and below fault traceback frame
AGENT_C_CONTEXT_WINDOW=15

# Whether to automatically commit verified patches to disk
AGENT_C_AUTO_APPLY_PATCH=false


# ------------------------------------------------------------------------------
# 5. AGENT D: PRODUCTION-QUALITY CODE REVIEW ASSISTANT
# ------------------------------------------------------------------------------
# Maximum LoopAgent auto-fix remediation iterations
AGENT_D_MAX_FIX_ITERATIONS=3

# Quality gate threshold for style score approval (0.0 to 100.0)
AGENT_D_STYLE_APPROVAL_THRESHOLD=85.0

# Minimum health score threshold for pull request approval (0.0 to 100.0)
AGENT_D_HEALTH_APPROVAL_THRESHOLD=80.0


# ------------------------------------------------------------------------------
# 6. AGENT E: E-COMMERCE SPORTS SHOP & VECTOR STORE
# ------------------------------------------------------------------------------
# Auto-sensing switch: If true, attempts 1.5s TCP probe to AlloyDB, smoothly
# falling back to local SQLite + NumPy vector search if unreachable.
FALLBACK_TO_LOCAL_SQLITE=true

# Local SQLite catalog file path (created automatically on startup if absent)
LOCAL_SQLITE_PATH=sports_shop_local.db

# Live Google Cloud AlloyDB for PostgreSQL Configuration (Optional)
# If hosted on GCP, set the cluster IP address and database credentials:
ALLOYDB_HOST=10.0.0.1
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=sports_shop
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=your_secure_alloydb_password
ALLOYDB_SSL_MODE=require

# Non-blocking probe timeout to test AlloyDB connectivity before fallback (seconds)
ALLOYDB_PROBE_TIMEOUT_SECONDS=1.5
