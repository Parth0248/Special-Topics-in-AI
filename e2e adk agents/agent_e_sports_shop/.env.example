# ==============================================================================
# Agent E: Sports Shop Agent - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live Gemini model and text-embedding-004)
# If omitted or invalid, Agent E seamlessly operates in deterministic offline mode
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# AlloyDB Live Database Connection (Optional)
# If ALLOYDB_HOST is omitted, unreachable, or fails connection probe within 1.5s,
# Agent E automatically falls back to local SQLite + NumPy vector search.
ALLOYDB_HOST=10.0.0.1
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=sports_shop
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=your_secure_password
ALLOYDB_SSL_MODE=require
FALLBACK_TO_LOCAL_SQLITE=true

# Local SQLite Configuration
LOCAL_DB_PATH=sports_shop_local.db

# Logging & Integrity
LOG_LEVEL=INFO
AGENT_INTEGRITY_MODE=demo
